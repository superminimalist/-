# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# used for magic-link redirect; falls back to request host
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# LiveKit Cloud → Settings → Keys
NEXT_PUBLIC_LIVEKIT_URL=wss://xxxx.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# optional: recording via Supabase Storage S3 (Storage → Settings → S3 Connection → New access key)
RECORDING_S3_ACCESS_KEY=
RECORDING_S3_SECRET=
RECORDING_S3_REGION=ap-northeast-2
# RECORDING_S3_ENDPOINT=https://xxxx.supabase.co/storage/v1/s3

# shift Hijri date ±N days to match local moon sighting
NEXT_PUBLIC_HIJRI_OFFSET_DAYS=0
